# App Store Connect API key for fastlane. Copy to `.env` (gitignored) and fill in:
#   App Store Connect -> Users and Access -> Integrations -> App Store Connect API.
# The private key lives at ~/.appstoreconnect/AuthKey_<ASC_API_KEY_ID>.p8, or set
# ASC_API_KEY_PATH.
ASC_API_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# ASC_API_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
# APPLE_TEAM_ID=XXXXXXXXXX
