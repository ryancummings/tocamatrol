# Tocamatrol release and screenshot lanes. Run from ios/ on a Mac with Xcode installed.
# Signing requires a GUI keychain session (SSH sessions without an unlocked keychain will fail).
# Nothing here submits automatically for App Store review.
require "fileutils"
require "shellwords"

# Non-interactive shells have no locale; fastlane's Ruby then fails on non-ASCII bytes.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
ENV["LANG"] ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"

skill = File.expand_path(ENV["MOBILE_STORE_RELEASE_SKILL"] || "~/.agents/skills/mobile-store-release")
release_helpers = File.join(skill, "scripts", "fastlane", "release_helpers")
screenshot_sync_helper = File.join(skill, "scripts", "fastlane", "screenshot_sync")
require release_helpers if File.exist?("#{release_helpers}.rb")
require screenshot_sync_helper if File.exist?("#{screenshot_sync_helper}.rb")
require_relative "creative_assets"

# Fallback if release_helpers wasn't loaded: ensure Apple /usr/bin/rsync precedes Homebrew rsync.
unless defined?(OneRadStoreRelease) && OneRadStoreRelease.respond_to?(:ensure_apple_rsync_path!)
  ENV["PATH"] = (["/usr/bin"] + ENV["PATH"].to_s.split(File::PATH_SEPARATOR).reject { |p| p == "/usr/bin" }).join(File::PATH_SEPARATOR)
end

APP_BUNDLE_ID = "com.OneRadStudio.tocamatrol"
FASTLANE_DIR = [Dir.pwd, File.join(Dir.pwd, "fastlane"), File.expand_path(__dir__)]
               .map { |d| File.expand_path(d) }
               .find { |d| File.exist?(File.join(d, "Fastfile")) } || File.expand_path(__dir__)
IOS_DIR = File.dirname(FASTLANE_DIR)
REPO_DIR = File.dirname(IOS_DIR)
BUILD_DIR = File.join(IOS_DIR, "build")
IPA = File.join(BUILD_DIR, "Tocamatrol.ipa")
METADATA_DIR = File.join(FASTLANE_DIR, "metadata")
DELIVER_DIR = File.join(FASTLANE_DIR, "deliver_screenshots")
RAW_SHOTS_DIR = File.join(FASTLANE_DIR, "screenshots", "en-US")

def resolve_team_id(ios_dir)
  env_team = ENV["APPLE_TEAM_ID"].to_s.strip
  return env_team unless env_team.empty?

  local_config = File.join(ios_dir, "LocalSigning.xcconfig")
  return "" unless File.exist?(local_config)

  match = File.read(local_config).match(/^\s*DEVELOPMENT_TEAM\s*=\s*([A-Z0-9]+)/)
  match ? match[1] : ""
end

TEAM_ID = resolve_team_id(IOS_DIR)

ASC_KEY_ID = ENV["ASC_API_KEY_ID"].to_s
ASC_ISSUER = ENV["ASC_ISSUER_ID"].to_s
ASC_KEY_PATH = File.expand_path(ENV["ASC_API_KEY_PATH"] || "~/.appstoreconnect/AuthKey_#{ASC_KEY_ID}.p8")

ASC_RELEASE = if defined?(OneRadStoreRelease::AppStoreConnect)
                OneRadStoreRelease::AppStoreConnect.new(
                  app_identifier: APP_BUNDLE_ID,
                  metadata_path: METADATA_DIR
                )
              end

def require_asc_release!
  return ASC_RELEASE if ASC_RELEASE

  UI.user_error!(
    "App Store Connect release helpers not loaded. Set MOBILE_STORE_RELEASE_SKILL " \
    "to your mobile-store-release skill path."
  )
end

def new_screenshot_sync
  require_asc_release!.login!
  unless defined?(ScreenshotSync)
    UI.user_error!(
      "ScreenshotSync helper not loaded. Set MOBILE_STORE_RELEASE_SKILL " \
      "to your mobile-store-release skill path."
    )
  end
  ScreenshotSync.new(app_identifier: APP_BUNDLE_ID, screenshots_path: DELIVER_DIR)
end

# The screenshot simulators, as in fastlane/Snapfile. Keep the two lists in step.
SHOT_RUNTIME = ENV["SHOT_RUNTIME"] || "com.apple.CoreSimulator.SimRuntime.iOS-27-2"
SHOT_DEVICES = {
  "Tocamatrol-Shots-iPhone17e" => "com.apple.CoreSimulator.SimDeviceType.iPhone-17e",
  "Tocamatrol-Shots-iPhone17ProMax" => "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max",
  "Tocamatrol-Shots-iPadmini" => "com.apple.CoreSimulator.SimDeviceType.iPad-mini-A20-Pro",
  "Tocamatrol-Shots-iPadPro13" => "com.apple.CoreSimulator.SimDeviceType.iPad-Pro-13-inch-M5-12GB"
}.freeze

# App-level settings applied by the store_settings lane. Tocamatrol has no web view, chat,
# user content, ads, location sharing or purchases, so every age-rating answer is "none".
AGE_RATING_BOOLEANS = %w[
  advertising ageAssurance datingAndRelationships gambling healthOrWellnessTopics lootBox messagingAndChat
  parentalControls sharedLocation socialMedia unrestrictedWebAccess userGeneratedContent
].freeze
AGE_RATING_FREQUENCIES = %w[
  alcoholTobaccoOrDrugUseOrReferences contests gamblingSimulated gunsOrOtherWeapons
  horrorOrFearThemes matureOrSuggestiveThemes medicalOrTreatmentInformation profanityOrCrudeHumor
  sexualContentGraphicAndNudity sexualContentOrNudity violenceCartoonOrFantasy
  violenceRealistic violenceRealisticProlongedGraphicOrSadistic
].freeze
STORE_SETTINGS = {
  copyright: "2026 One Rad Studio LLC",
  content_rights: "DOES_NOT_USE_THIRD_PARTY_CONTENT",
  primary_category: "PRODUCTIVITY",
  secondary_category: "UTILITIES",
  age_rating: AGE_RATING_BOOLEANS.to_h { |k| [k, false] }
                .merge(AGE_RATING_FREQUENCIES.to_h { |k| [k, "NONE"] })
}.freeze

default_platform(:ios)

platform :ios do
  desc "Build GitHub main with the next build number and upload it to TestFlight. " \
       "Pass branch:true to build the current checkout instead of main."
  lane :beta do |options|
    asc = require_asc_release!
    key = asc.api_key
    UI.user_error!("App Store Connect API key not configured: see fastlane/.env.example") if key.nil?
    UI.user_error!("Apple Team ID not configured: set APPLE_TEAM_ID or ios/LocalSigning.xcconfig") if TEAM_ID.empty?
    check_checkout! unless options[:branch]

    sh("cd #{IOS_DIR.shellescape} && xcodegen generate --quiet")
    sh("swift", "test", "--package-path", File.join(IOS_DIR, "TocaCore"))

    build = latest_testflight_build_number(api_key: key, app_identifier: APP_BUNDLE_ID,
                                           initial_build_number: 0) + 1
    build_app(
      project: File.join(IOS_DIR, "Tocamatrol.xcodeproj"),
      scheme: "Tocamatrol",
      configuration: "Release",
      export_method: "app-store",
      output_directory: BUILD_DIR,
      output_name: File.basename(IPA),
      clean: true,
      export_options: { signingStyle: "automatic", teamID: TEAM_ID },
      # The API key lets xcodebuild create the App Store profile without an Apple ID login.
      xcargs: "-allowProvisioningUpdates" \
              " -authenticationKeyPath #{ASC_KEY_PATH.shellescape}" \
              " -authenticationKeyID #{ASC_KEY_ID} -authenticationKeyIssuerID #{ASC_ISSUER}" \
              " CURRENT_PROJECT_VERSION=#{build}"
    )
    upload_to_testflight(
      api_key: key,
      ipa: IPA,
      skip_submission: true,                  # internal testers only; no beta review
      skip_waiting_for_build_processing: true # Apple processes it in 5-15 minutes
    )
    UI.success("Uploaded build #{build} (#{git_head}). It reaches TestFlight once Apple has processed it.")
  end

  desc "Capture the screenshot catalog on every Snapfile device, one simulator at a time. " \
       "Pass devices:\"Tocamatrol-Shots-iPadmini\" (comma-separated) for some of them."
  lane :screenshots do |options|
    devices = options[:devices] ? options[:devices].split(",").map(&:strip) : SHOT_DEVICES.keys
    sh("cd #{IOS_DIR.shellescape} && xcodegen generate --quiet")
    ensure_shot_devices(SHOT_DEVICES.keys)
    # Clear only the devices being captured, so a partial run keeps the others.
    devices.each { |device| FileUtils.rm_f(Dir.glob(File.join(RAW_SHOTS_DIR, "#{device}-*"))) }
    devices.each do |device|
      before = booted_simulators
      begin
        snapshot(devices: [device], concurrent_simulators: false, clear_previous_screenshots: false)
      ensure
        # Shut down only the simulator this run booted.
        (booted_simulators - before).each { |udid| sh("xcrun", "simctl", "shutdown", udid) rescue nil }
      end
      rotate_landscape_ipad_captures(device) if device.include?("iPad")
    end
    UI.success("Screenshots in #{RAW_SHOTS_DIR}")
  end

  desc "Render Ink & Pop comic App Store posters from fastlane/screenshots/en-US into fastlane/deliver_screenshots/en-US."
  lane :frame_posters do
    sh("python3", File.join(FASTLANE_DIR, "frame_posters.py"))
  end

  desc "Render the iOS 27 creative assets (product page header 21:9, search results 3:2) into " \
       "fastlane/creative and place them on the editable version's en-US page via the Asset " \
       "Library API. Idempotent. render:false uploads the existing files as they are."
  lane :creative_assets do |options|
    sh("python3", File.join(FASTLANE_DIR, "creative_assets.py")) unless options[:render] == false
    asc = require_asc_release!
    version = asc.editable_version(required: true)
    creative = File.join(FASTLANE_DIR, "creative")
    results = CreativeAssets.sync!(
      app_id: asc.app.id,
      version_id: version.id,
      ui: UI,
      jobs: [
        { file: File.join(creative, "header_21x9.png"), placement_type: "PRODUCT_PAGE_HEADER_ASSET",
          label: "Tocamatrol header #{version.version_string}" },
        { file: File.join(creative, "search_3x2.png"), placement_type: "APP_STORE_SEARCH_RESULTS_ASSET",
          label: "Tocamatrol search results #{version.version_string}" }
      ]
    )
    results.each do |r|
      UI.message("#{r[:placement]}: #{r[:file]} #{r[:size]} image=#{r[:image_state]} placements=#{r[:count]}")
    end
    UI.user_error!("Creative assets did not converge: #{results.reject { |r| r[:ok] }}") unless results.all? { |r| r[:ok] }
    UI.success("Creative assets verified on #{version.version_string} (en-US).")
  end

  desc "Withdraw the in-progress App Review submission (waiting or in review) so the version " \
       "becomes editable again. Does not resubmit."
  lane :cancel_review do
    app = require_asc_release!.app
    submission = app.get_in_progress_review_submission(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No iOS review submission is waiting or in review") if submission.nil?
    UI.message("Cancelling review submission #{submission.id} (#{submission.state})")
    submission.cancel_submission
    state = nil
    24.times do
      state = Spaceship::ConnectAPI::ReviewSubmission.get(review_submission_id: submission.id).state
      break unless state == Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::CANCELING
      sleep 5
    end
    version = require_asc_release!.editable_version
    UI.important("Submission #{submission.id}: #{state}; version #{version&.version_string} #{version&.app_store_state}")
    UI.user_error!("Submission did not finish cancelling (#{state})") unless state == "COMPLETE"
  end

  desc "Submit the editable version for App Review (explicit only: run it on purpose). " \
       "Requires version: to match the editable version, which must have a build attached."
  lane :submit_review do |options|
    asc = require_asc_release!
    version = asc.editable_version(required: true)
    unless options[:version].to_s == version.version_string
      UI.user_error!("Pass version:#{version.version_string} to confirm which version goes to review")
    end
    build = version.get_build
    UI.user_error!("No build attached to #{version.version_string}") if build.nil?
    app = asc.app
    platform = Spaceship::ConnectAPI::Platform::IOS
    submission = app.get_ready_review_submission(platform: platform, includes: "items") ||
                 app.create_review_submission(platform: platform)
    submission.add_app_store_version_to_review_items(app_store_version_id: version.id) if Array(submission.items).empty?
    submission.submit_for_review
    fresh = app.get_in_progress_review_submission(platform: platform)
    version = Spaceship::ConnectAPI::AppStoreVersion.get(app_store_version_id: version.id)
    UI.important("Submission #{fresh&.id}: #{fresh&.state}; #{version.version_string} (#{build.version}) #{version.app_store_state}")
    UI.user_error!("Submission is not waiting for review") unless fresh&.state == "WAITING_FOR_REVIEW"
  end

  desc "Reconcile App Store Connect screenshots with fastlane/deliver_screenshots (idempotent)."
  lane :screenshots_sync do
    sync = new_screenshot_sync
    plan = sync.local_screenshot_plan
    expected = plan.values.sum { |types| types.values.sum(&:count) }
    plan.each { |locale, types| UI.message("local: #{locale} — #{types.map { |t, e| "#{t}=#{e.count}" }.join(', ')}") }

    version = sync.asc_edit_version
    passes = 6
    converged = false
    passes.times do |i|
      UI.important("reconcile pass #{i + 1}/#{passes}")
      changed = sync.reconcile_screenshots(version, plan)
      sync.wait_for_screenshot_processing(version) if changed
      unless changed
        converged = true
        break
      end
    end
    UI.user_error!("Screenshots did not converge after #{passes} passes — run `fastlane ios screenshots_audit`.") unless converged

    sync.sort_remote_screenshots(version, plan)
    problems = sync.verify_screenshots(version, plan)
    unless problems.empty?
      problems.each { |p| UI.error(p) }
      UI.user_error!("Screenshots on App Store Connect do not match local. See errors above.")
    end

    counts = sync.remote_screenshot_counts(version)
    total = counts.values.sum
    UI.user_error!("Expected #{expected} screenshots, found #{total} #{counts}") if total != expected
    UI.success("Screenshots verified: #{total} on App Store Connect, exactly matching local.")
  end

  desc "READ-ONLY: report remote App Store Connect screenshot sets and counts."
  lane :screenshots_audit do
    sync = new_screenshot_sync
    version = sync.asc_edit_version
    UI.important("version #{version.version_string} (#{version.app_store_state})")
    version.get_app_store_version_localizations.each do |loc|
      sets = loc.get_app_screenshot_sets
      UI.important("#{loc.locale}: #{sets.count} set(s)")
      sets.each do |set|
        shots = set.app_screenshots || []
        UI.message("  #{set.screenshot_display_type}: #{shots.count}")
        shots.each { |s| UI.message("    #{s.file_name} state=#{(s.asset_delivery_state || {})['state']}") }
      end
    end
  end

  desc "Set App Review information on the editable version: notes from " \
       "metadata/review_information/notes.txt, contact from REVIEW_FIRST_NAME, REVIEW_LAST_NAME, " \
       "REVIEW_PHONE and REVIEW_EMAIL in fastlane/.env (kept out of the public repo). Idempotent."
  lane :review_info do
    version = require_asc_release!.editable_version(required: true)
    contact = %w[REVIEW_FIRST_NAME REVIEW_LAST_NAME REVIEW_PHONE REVIEW_EMAIL].to_h { |k| [k, ENV[k].to_s.strip] }
    missing = contact.select { |_, v| v.empty? }.keys
    UI.user_error!("Set #{missing.join(', ')} in fastlane/.env") unless missing.empty?
    attributes = {
      contact_first_name: contact["REVIEW_FIRST_NAME"],
      contact_last_name: contact["REVIEW_LAST_NAME"],
      contact_phone: contact["REVIEW_PHONE"],
      contact_email: contact["REVIEW_EMAIL"],
      demo_account_required: false,
      notes: File.read(File.join(METADATA_DIR, "review_information", "notes.txt")).strip
    }
    # A first version has no review detail yet, and fetching one raises "No data".
    detail = begin
      version.fetch_app_store_review_detail
    rescue RuntimeError => e
      raise unless e.message.include?("No data")

      nil
    end
    if detail
      changed = attributes.reject { |k, v| detail.send(k) == v }
      if changed.empty?
        UI.message("App Review information already up to date")
      else
        Spaceship::ConnectAPI.patch_app_store_review_detail(app_store_review_detail_id: detail.id,
                                                            attributes: camel_attributes(changed))
      end
    else
      Spaceship::ConnectAPI.post_app_store_review_detail(app_store_version_id: version.id,
                                                         attributes: camel_attributes(attributes))
    end

    remote = version.fetch_app_store_review_detail
    drift = attributes.keys.reject { |k| remote.send(k) == attributes[k] }
    UI.user_error!("App Review information differs on App Store Connect: #{drift.join(', ')}") unless drift.empty?
    UI.success("App Review information verified on #{version.version_string} (#{attributes[:notes].length} characters of notes).")
  end

  desc "Set the app-level App Store settings that deliver does not cover: copyright, categories, " \
       "content rights and the age rating questionnaire (no objectionable content: 4+). Idempotent."
  lane :store_settings do
    asc = require_asc_release!
    app = asc.app
    version = asc.editable_version(required: true)
    info = app.fetch_edit_app_info || UI.user_error!("No editable app info")
    api = Spaceship::ConnectAPI.tunes_request_client

    version.update(attributes: { copyright: STORE_SETTINGS[:copyright] }) unless version.copyright == STORE_SETTINGS[:copyright]
    unless app.content_rights_declaration == STORE_SETTINGS[:content_rights]
      app.update(attributes: { contentRightsDeclaration: STORE_SETTINGS[:content_rights] })
    end
    info.update_categories(category_id_map: { primary_category_id: STORE_SETTINGS[:primary_category],
                                              secondary_category_id: STORE_SETTINGS[:secondary_category] })
    declaration = api.get("v1/appInfos/#{info.id}/ageRatingDeclaration").body["data"]
    wanted = STORE_SETTINGS[:age_rating]
    unless wanted.all? { |k, v| declaration["attributes"][k] == v }
      api.patch("v1/ageRatingDeclarations/#{declaration['id']}",
                { data: { type: "ageRatingDeclarations", id: declaration["id"], attributes: wanted } })
    end

    # Fresh queries, not the write responses.
    app = asc.app
    version = asc.editable_version(required: true)
    info = app.fetch_edit_app_info
    remote_age = api.get("v1/appInfos/#{info.id}/ageRatingDeclaration").body["data"]["attributes"]
    problems = []
    problems << "copyright #{version.copyright.inspect}" unless version.copyright == STORE_SETTINGS[:copyright]
    problems << "content rights #{app.content_rights_declaration.inspect}" unless app.content_rights_declaration == STORE_SETTINGS[:content_rights]
    problems << "primary category #{info.primary_category&.id.inspect}" unless info.primary_category&.id == STORE_SETTINGS[:primary_category]
    problems << "secondary category #{info.secondary_category&.id.inspect}" unless info.secondary_category&.id == STORE_SETTINGS[:secondary_category]
    wanted.each { |k, v| problems << "age rating #{k}=#{remote_age[k].inspect}" unless remote_age[k] == v }
    UI.user_error!("Store settings differ on App Store Connect: #{problems.join(', ')}") unless problems.empty?
    UI.success("Store settings verified (age rating #{info.app_store_age_rating || 'pending calculation'}).")
  end

  desc "Upload App Store listing metadata from fastlane/metadata without submitting for review"
  lane :sync_metadata do
    require_asc_release!.upload_metadata!
  end

  desc "READ-ONLY: report App Store Connect version status and local-vs-remote metadata parity."
  lane :metadata_status do
    asc = require_asc_release!
    asc.status
    asc.download_metadata(write: false)
  end

  desc "List the latest builds on App Store Connect (read-only)"
  lane :builds do
    require_asc_release!.recent_builds.each do |b|
      UI.message("#{b.pre_release_version&.version} (#{b.version})  #{b.processing_state}  #{b.uploaded_date}")
    end
  end

  desc "Attach a processed TestFlight build to the editable App Store version (does NOT submit for review)."
  lane :attach_build do |options|
    require_asc_release!.attach_build!(
      marketing_version: options[:version] || "1.0",
      build_number: options[:build]
    )
  end
end

# Builds only what is on GitHub main, committed, so every TestFlight build has a commit.
def check_checkout!
  sh("git", "-C", REPO_DIR, "fetch", "--quiet", "origin", "main")
  dirty = sh("git", "-C", REPO_DIR, "status", "--porcelain", log: false).strip
  UI.user_error!("Uncommitted changes in #{REPO_DIR}") unless dirty.empty?
  origin = sh("git", "-C", REPO_DIR, "rev-parse", "origin/main", log: false).strip
  return if git_head == origin

  UI.user_error!("This checkout is not GitHub main. Run `git switch main && git pull --ff-only`, " \
                 "or pass branch:true to build it anyway.")
end

# The raw App Store Connect API takes camelCase names; Spaceship models read snake_case.
def camel_attributes(attributes)
  attributes.transform_keys { |k| k.to_s.gsub(/_([a-z])/) { Regexp.last_match(1).upcase } }
end

def ensure_shot_devices(names)
  available = sh("xcrun", "simctl", "list", "devices", "available", log: false)
  names.each do |name|
    UI.user_error!("Unknown screenshot device #{name}") unless SHOT_DEVICES.key?(name)
    next if available.include?("#{name} (")

    sh("xcrun", "simctl", "create", name, SHOT_DEVICES[name], SHOT_RUNTIME)
  end
end

def booted_simulators
  sh("xcrun", "simctl", "list", "devices", "booted", log: false).scan(/\(([0-9A-F-]{36})\) \(Booted\)/).flatten
end

def git_head
  sh("git", "-C", REPO_DIR, "rev-parse", "HEAD", log: false).strip
end

# Landscape-only iPad captures from fastlane snapshot arrive rotated 90 degrees clockwise (2064x2752).
def rotate_landscape_ipad_captures(device)
  Dir.glob(File.join(RAW_SHOTS_DIR, "#{device}-*.png")).sort.each do |path|
    width, height = `magick identify -format "%w %h" #{path.shellescape}`.strip.split.map(&:to_i)
    next unless height > width

    sh("magick", path, "-rotate", "-90", path)
  end
end
